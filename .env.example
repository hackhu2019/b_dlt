# Copy to .env and fill only what you actually use.

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Optional Bilibili auth settings
# Supported values: none / browser / cookies_file / cookie_header
BILIBILI_AUTH_MODE=none
BILIBILI_BROWSER=chrome
BILIBILI_COOKIES_FILE=
BILIBILI_COOKIE_HEADER=

# Optional runtime settings
DEFAULT_LANGUAGE=zh
OUTPUT_DIR=./data
SQLITE_PATH=./db/knowledge.db
